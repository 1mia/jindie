    public String projectFields() {
        List<String> fields = new ArrayList<>();
        fields.add("id as project_id");//主键id
        fields.add("billno as project_billno");//线索编号
        fields.add("name as project_name");//名称
        fields.add("customer.id as project_customer_id");//业主名称
        fields.add("project_address as project_address");//地点
        fields.add("contract_amount as project_contract_amount");//项目预算
        fields.add("description as project_description");//项目概况
        fields.add("jfq5_opportunityowne.id as project_owner_id");//负责人
        fields.add("start_date as project_start_date");//计划招标时间
        return String.join(", ", fields);
